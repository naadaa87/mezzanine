{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mezzanine",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mezzanine-db",
      "database_id": "b1401fea-ad2a-4111-89df-f736bba2e0c1"
    }
  ],
  "observability": {
    "enabled": true
  }
}
